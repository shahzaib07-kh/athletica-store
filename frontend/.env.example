# ==============================================================================
# ATHLETICA — Environment Configuration Template (Development & Staging)
# ==============================================================================

# Public Canonical Site URL (Used for metadataBase, OpenGraph, sitemap.xml, robots.txt)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public Media CDN / Asset URL (Used by ProductCard, ProductGallery for /uploads/* images)
# In development, points to local PHP server serving the ATHLETICA root directory
NEXT_PUBLIC_MEDIA_URL=http://127.0.0.1:8000

# PHP REST API Base URL (Used by Server Components and Next.js Reverse-Proxy Rewrites)
# In development: http://127.0.0.1:8000/api
# In unified Nginx production: http://127.0.0.1:8080/api (or internal PHP-FPM fastcgi)
PHP_API_URL=http://127.0.0.1:8000/api
