# ==============================================================================
# ATHLETICA — Production Environment Configuration (.env.production)
# ==============================================================================

# 1. Public Site Canonical Domain (HTTPS)
NEXT_PUBLIC_SITE_URL=https://athletica.pk

# 2. Public Media URL
# In unified Nginx reverse-proxy setup, /uploads/* is routed directly on the same domain:
NEXT_PUBLIC_MEDIA_URL=https://athletica.pk

# 3. Internal PHP REST API Endpoint
# Used by Next.js Server Components and Reverse Proxy rewrites
# In unified Nginx setup where PHP is served via fastcgi/Apache locally:
PHP_API_URL=http://127.0.0.1:8080/api

# Node Environment
NODE_ENV=production
PORT=3000
