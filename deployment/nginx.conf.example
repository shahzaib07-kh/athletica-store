# ==============================================================================
# ATHLETICA — Unified Nginx Reverse Proxy Production Configuration
# Domain: athletica.pk / www.athletica.pk
# ==============================================================================

# Upstream Next.js Node.js Server (PM2 cluster on port 3000)
upstream nextjs_upstream {
    server 127.0.0.1:3000;
    keepalive 64;
}

# 1. HTTP -> HTTPS Redirect (All traffic redirected to HTTPS)
server {
    listen 80;
    listen [::]:80;
    server_name athletica.pk www.athletica.pk;

    # Let's Encrypt ACME Challenge Directory
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://athletica.pk$request_uri;
    }
}

# 2. Redirect www.athletica.pk -> athletica.pk (Canonical Apex Domain)
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.athletica.pk;

    ssl_certificate /etc/letsencrypt/live/athletica.pk/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/athletica.pk/privkey.pem;

    return 301 https://athletica.pk$request_uri;
}

# 3. Main Production Server Block (HTTPS)
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name athletica.pk;

    # Root directory for PHP Backend and static uploads
    root /var/www/athletica;
    index index.php;

    # --------------------------------------------------------------------------
    # SSL Hardening & Modern Ciphers
    # --------------------------------------------------------------------------
    ssl_certificate /etc/letsencrypt/live/athletica.pk/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/athletica.pk/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # --------------------------------------------------------------------------
    # Security Headers
    # --------------------------------------------------------------------------
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;

    # --------------------------------------------------------------------------
    # Gzip Compression
    # --------------------------------------------------------------------------
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/rss+xml application/atom+xml image/svg+xml;

    # Client upload limits (Images max 5MB)
    client_max_body_size 10M;

    # ==========================================================================
    # ROUTE 1: Next.js Static Chunks & Build Assets (Aggressive Caching)
    # ==========================================================================
    location /_next/static/ {
        proxy_pass http://nextjs_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        expires 365d;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # ==========================================================================
    # ROUTE 2: Uploaded Media Files (/uploads/*)
    # Serves images directly from disk; blocks script execution
    # ==========================================================================
    location ^~ /uploads/ {
        alias /var/www/athletica/uploads/;
        expires 30d;
        access_log off;
        add_header Cache-Control "public, max-age=2592000";

        # Block any PHP or executable script execution inside uploads
        location ~ \.(php|phtml|php3|php4|php5|phps|cgi|pl|py|sh|bash)$ {
            deny all;
        }
    }

    # ==========================================================================
    # ROUTE 3: PHP REST API (/api/*)
    # Routed directly to PHP-FPM fastcgi processor
    # ==========================================================================
    location ^~ /api/ {
        try_files $uri $uri/ /api/bootstrap.php?$query_string;

        location ~ \.php$ {
            include fastcgi_params;
            fastcgi_pass unix:/run/php/php8.2-fpm.sock;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            fastcgi_param HTTPS on;
            fastcgi_read_timeout 60;
        }
    }

    # ==========================================================================
    # ROUTE 4: Admin Panel (/admin/*)
    # Routed directly to PHP-FPM for the PHP Admin Panel
    # ==========================================================================
    location ^~ /admin/ {
        try_files $uri $uri/ /admin/index.php?$query_string;

        location ~ \.php$ {
            include fastcgi_params;
            fastcgi_pass unix:/run/php/php8.2-fpm.sock;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            fastcgi_param HTTPS on;
            fastcgi_read_timeout 60;
        }
    }

    # ==========================================================================
    # ROUTE 5: Customer Storefront (Next.js Node.js Server)
    # All other HTML routes (/, /shop, /product/*, /cart, /checkout, etc.)
    # ==========================================================================
    location / {
        proxy_pass http://nextjs_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
